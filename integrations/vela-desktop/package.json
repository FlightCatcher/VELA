{
  "name": "vela-desktop",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "VELA independent local-first AI agent desktop.",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.12",
    "marked": "18.0.7"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.vela.desktop",
    "productName": "VELA",
    "asar": true,
    "asarUnpack": [
      "src/native_image_engine.py",
      "src/compose_references.py",
      "src/prepare_vision_image.py"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "workflows/**/*",
      "references/**/*",
      "build/vela-icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../src",
        "to": "agent/src"
      },
      {
        "from": "../../configs",
        "to": "agent/configs"
      },
      {
        "from": "../../prompts",
        "to": "agent/prompts"
      },
      {
        "from": "../../pyproject.toml",
        "to": "agent/pyproject.toml"
      },
      {
        "from": "../../uv.lock",
        "to": "agent/uv.lock"
      },
      {
        "from": "../../README.md",
        "to": "agent/README.md"
      }
    ],
    "win": {
      "icon": "build/vela-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "VELA-Desktop.exe"
    }
  }
}
